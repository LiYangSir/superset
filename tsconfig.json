{
	"extends": "@superset/typescript/electron.json",
	"compilerOptions": {
		"baseUrl": ".",
		"paths": {
			"*": ["src/*"],
			"~/*": ["./*"]
		}
	},
	"include": [
		"./src",
		"vite.config.ts"
	],
	"exclude": [
		"node_modules",
		"dist",
		"src/**/templates/**",
		"src/resources/browser-extension"
	]
}
