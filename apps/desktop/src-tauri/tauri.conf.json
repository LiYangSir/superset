{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "Superset",
  "identifier": "com.superset.desktop",
  "version": "0.1.0",
  "build": {
    "beforeDevCommand": "bun run dev:renderer",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun run build:renderer",
    "frontendDist": "../dist/renderer"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Superset",
        "width": 1280,
        "height": 800,
        "minWidth": 400,
        "minHeight": 400,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 26 },
        "center": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src 'self' data: blob: ws: wss: http://127.0.0.1:* https: ipc: http://ipc.localhost; img-src 'self' data: blob: https: http: asset: http://asset.localhost; font-src 'self'; frame-src https: http: data: blob:; child-src 'self' blob:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "frameworks": [],
      "entitlements": null
    },
    "resources": [
      "resources/sounds/*"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["superset"]
      }
    }
  }
}
